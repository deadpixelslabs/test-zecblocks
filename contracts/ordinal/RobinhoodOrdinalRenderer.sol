pragma solidity 0.8.26;

/// @title Robinhood Ordinal Block — deterministic on-chain SVG artwork
/// @notice Art renderer only. No NFT minting, ownership, fees, or external resources.
/// @dev Every visible coordinate, palette and fragment lives in this contract.
/// designCode encodes palette(2), core(2), crown(2), panels(2), seal(8) bits.
/// This renderer has no owner, mutable storage, timestamp, randomness, or upgrade path.
contract RobinhoodOrdinalRenderer {
    function renderSVG(uint16 designCode) external pure returns (string memory) {
        uint256 code = uint256(designCode);
        return string.concat(
            '<svg xmlns="http://www.w3.org/2000/svg" width="1024" height="1024" viewBox="0 0 1024 1024">',
            _palette(code & 3), _scaffold(), _core((code >> 2) & 3),
            _foreground(), _crown((code >> 4) & 3), _panels((code >> 6) & 3),
            _seal(code >> 8), '</svg>'
        );
    }

    function traits(uint16 designCode) external pure returns (uint8 palette, uint8 core, uint8 crown, uint8 panels, uint8 seal) {
        uint256 c = uint256(designCode);
        return (uint8(c & 3), uint8((c>>2)&3), uint8((c>>4)&3), uint8((c>>6)&3), uint8(c>>8));
    }

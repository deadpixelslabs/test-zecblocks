function _seal(uint256 value) private pure returns (string memory out) {
    // Eight visible inset cells provide an injective eight-bit geometric seal.
    out = '<g transform="matrix(4 2 0 4 112 300)">';
    for (uint256 i; i < 8; ++i) {
        string memory ink = (value & (1 << i)) != 0 ? '#beff48' : '#10372a';
        out = string.concat(out, '<rect x="', _uint(19 + 8*i), '" y="82" width="5" height="6" rx=".5" fill="', ink, '"/>');
    }
    out=string.concat(out,'</g><g transform="matrix(4 -2 0 4 512 500)"><path d="M20 85.5h50" stroke="#13764b" stroke-width=".8"/><path d="M75 82v7M80 82v7" stroke="#74da68" stroke-width="1.4"/></g>');
}
function _uint(uint256 value) private pure returns (string memory) {
    if (value == 0) return "0";
    uint256 t=value; uint256 length;
    while(t!=0){ ++length; t/=10; }
    bytes memory out=new bytes(length);
    while(value!=0){ out[--length]=bytes1(uint8(48+value%10)); value/=10; }
    return string(out);
}
